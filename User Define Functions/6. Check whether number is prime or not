import math

def is_prime(number):
    if number < 1:
        return False

    if number == 2:
        return True

    if number % 2 == 0:
        return False

    limit = int(math.sqrt(number))

    for i in range(3, limit + 1, 2):
        if number % i == 0:
            return False

    return True

print(is_prime(11))
print(is_prime(22))
print(is_prime(5))
print(is_prime(8))
